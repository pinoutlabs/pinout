{
  "id": "awareness-connector-e2e",
  "title": "Plug in anything → awareness → connector → human approve → MCP agent",
  "evidenceLabel": "SIMULATED",
  "honesty": [
    "All devices in this scenario are fixtures. Pinout has never run on real hardware in this repository.",
    "Evidence for generated connectors must never exceed COMPILE_TESTED without a dated hardware/records entry.",
    "Nothing is auto-armed. Physical-output capabilities stay rejected until a human approves ranges."
  ],
  "steps": [
    {
      "id": "boot",
      "action": "boot_pinoutd_mock_discovery",
      "mockDevices": "fixtures/mock-devices.json",
      "expect": { "mode": "mock-discovery", "label": "SIMULATED" }
    },
    {
      "id": "known-recognized",
      "action": "list_awareness",
      "expect": {
        "deviceId": "mock-serial-esp32-known",
        "state": "IDENTIFIED",
        "moduleId": "pinout/esp32"
      }
    },
    {
      "id": "unknown-appears",
      "action": "list_awareness",
      "expect": {
        "deviceId": "mock-ble-unknown-lamp",
        "state": "SEEN",
        "moduleId": null,
        "evidenceLevel": "UNKNOWN"
      }
    },
    {
      "id": "generate-connector",
      "action": "generate_connector",
      "awarenessId": "mock-ble-unknown-lamp",
      "expect": {
        "status": "QUARANTINED",
        "evidenceLevelMax": "COMPILE_TESTED",
        "mode": "read-only"
      }
    },
    {
      "id": "readonly-status-ok",
      "action": "invoke_connector_capability",
      "capability": "lamp.status",
      "args": {},
      "expect": { "ok": true }
    },
    {
      "id": "physical-before-approve-rejected",
      "action": "invoke_connector_capability",
      "capability": "lamp.setBrightness",
      "args": { "percent": 40 },
      "expect": { "ok": false, "code": "SAFETY_APPROVAL_REQUIRED" }
    },
    {
      "id": "human-approves",
      "action": "approve_connector",
      "marker": "HUMAN APPROVES",
      "ranges": {
        "lamp.setBrightness": {
          "percent": { "min": 0, "max": 80 }
        }
      },
      "capabilities": ["lamp.setBrightness", "lamp.status"],
      "expect": { "status": "APPROVED" }
    },
    {
      "id": "install",
      "action": "install_connector",
      "expect": { "status": "INSTALLED", "armed": false }
    },
    {
      "id": "out-of-range-rejected",
      "action": "invoke_connector_capability",
      "capability": "lamp.setBrightness",
      "args": { "percent": 95 },
      "expect": { "ok": false, "code": "POLICY_CONSTRAINT_VIOLATION" }
    },
    {
      "id": "in-range-ok",
      "action": "invoke_connector_capability",
      "capability": "lamp.setBrightness",
      "args": { "percent": 40 },
      "expect": { "ok": true, "armed": false }
    },
    {
      "id": "mcp-agent-session",
      "action": "scripted_mcp_agent_loop",
      "tools": [
        "pinout__nearby_devices",
        "pinout__describe_nearby",
        "pinout__generate_connector",
        "pinout__connector_status",
        "pinout__list_connectors"
      ],
      "transcript": "transcript.md"
    }
  ]
}
