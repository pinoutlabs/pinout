{
  "name": "pinout",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Hardware abstraction layer for programmable devices — SDK, CLI, firmware, and MCP adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMisbahk/pinout.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "pretest": "npm run build --silent && tsc -p examples/external-module/weird-sensor/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "typecheck:tests": "tsc -p tsconfig.test.json --pretty",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-check.mjs --strict",
    "release:dry-run": "node scripts/release-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "pinout": "npm run build --silent && node packages/cli/dist/index.js",
    "example:blink": "npm run build --silent && tsx examples/blink.ts",
    "example:pwm": "npm run build --silent && tsx examples/pwm.ts",
    "example:analog": "npm run build --silent && tsx examples/analog.ts",
    "example:watch": "npm run build --silent && tsx examples/watch.ts",
    "example:script": "npm run build --silent && tsx examples/script.ts",
    "example:agent-tools": "npm run build --silent && tsx examples/agent-tools.ts",
    "demo:heterogeneous": "npm run build --silent && tsx examples/heterogeneous.ts",
    "demo:lamp": "npm run build --silent && tsx examples/lamp.ts",
    "demo:lamp-modbus": "npm run build --silent && tsx examples/lamp-modbus.ts",
    "example:ros2-sidecar": "npm run build --silent && tsx examples/ros2-sidecar.ts",
    "demo:robotics": "npm run build --silent && tsx examples/robotics-parts.ts",
    "demo:composite": "npm run build --silent && tsx examples/multi-driver-rig.ts",
    "demo:generate": "npm run build --silent && node packages/cli/dist/index.js generate ./fixtures/generator/heatbox-sdk --plan",
    "eval:generator": "npm run build --silent && vitest run packages/generator/tests/generator.test.ts",
    "eval:generator:live": "PINOUT_GENERATOR_PROVIDER=http npm run build --silent && vitest run packages/generator/tests/generator.test.ts",
    "example:mcp-heterogeneous": "npm run build --silent && tsx examples/mcp-heterogeneous.ts",
    "mcp": "npm run build --silent && node scripts/mcp-bootstrap.js",
    "mcp:heterogeneous": "npm run build --silent && PINOUT_DEMO=heterogeneous node packages/mcp/dist/index.js",
    "demo:physical-intelligence": "npm run build --silent && tsx examples/physical-intelligence.ts",
    "demo:generate-device": "npm run build --silent && tsx examples/generate-device.ts",
    "demo:coffee": "npm run build --silent && tsx examples/coffee-machine.ts",
    "bench": "npm run build --silent && tsx scripts/benchmark.ts",
    "bench:mcp": "npm run build --silent && tsx scripts/benchmark-mcp.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@pinout/cli": "*",
    "@pinout/core": "*",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
}
