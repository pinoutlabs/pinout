{
  "name": "@pinout/core",
  "version": "0.0.1-alpha.1",
  "description": "Hardware abstraction core for Pinout — devices, capabilities, transports, and protocol.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./serial": {
      "types": "./dist/serial.d.ts",
      "default": "./dist/serial.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "license": "Apache-2.0",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinoutlabs/pinout.git"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
