{
  "name": "@pinout/daemon",
  "version": "0.0.1-alpha.1",
  "description": "pinoutd — the local physical execution service for Pinout.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinoutlabs/pinout.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pinoutd": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pinout/core": "0.0.1-alpha.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.10"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
