{
  "name": "@pinout/cli",
  "version": "0.0.1-alpha.1",
  "description": "Command-line interface for Pinout.",
  "type": "module",
  "bin": {
    "pinout": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./connection": {
      "types": "./dist/connectionArgs.d.ts",
      "default": "./dist/connectionArgs.js"
    },
    "./script": {
      "types": "./dist/runScript.d.ts",
      "default": "./dist/runScript.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "license": "Apache-2.0",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinoutlabs/pinout.git"
  },
  "dependencies": {
    "@pinout/core": "0.0.1-alpha.1",
    "commander": "^12.1.0",
    "@pinout/daemon": "0.0.1-alpha.1",
    "@pinout/discovery": "0.0.1-alpha.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
